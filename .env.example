# Copy this file to ".env" in the project root and edit it.
# ".env" is in .gitignore. NEVER commit it. Only this ".env.example" goes to GitHub.
# On Replit, put these values in the "Secrets" tool instead of a .env file.

# --- Backend (Feature 1) ---------------------------------------------------
# Leave DATABASE_URL commented out to use the default: backend/data/inventory.db
# DATABASE_URL=sqlite:///./data/inventory.db

# Create synthetic demo data automatically when the database is empty
AUTO_SEED=true

# Feature 7: add ~30 days of synthetic stock history to the demo products (for the dashboard
# trends). Only affects demo products that have not been used yet. Set to false to switch off.
SEED_HISTORY=true

# Feature 3: prepare purchase order DRAFTS automatically when a product runs low.
# Set to false to only create drafts with the "Check restocking needs" button.
AUTO_GENERATE_PO=true

# --- Sign-in (demo account) ---------------------------------------------------
# Defaults: business123@gmail.com / SISO67# (synthetic demo account)
# DEMO_LOGIN_EMAIL=business123@gmail.com
# DEMO_LOGIN_PASSWORD=          (leave empty to use the built-in demo password)
# Set any long random text to stay signed in when the backend restarts:
# SESSION_SECRET=
# SESSION_HOURS=12
# REQUIRE_LOGIN=true            (only the automated tests switch this off)

# Only needed if the browser calls the backend directly (normally it does not,
# because the Vite dev server forwards /api requests)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (optional) ----------------------------------------------------
# Where the Vite dev server forwards /api requests. Default: http://127.0.0.1:8000
# VITE_BACKEND_URL=http://127.0.0.1:8000

# --- RunPod (Feature 9: NOT used yet) -----------------------------------------
# These stay in the BACKEND only. Never put them in frontend code.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
